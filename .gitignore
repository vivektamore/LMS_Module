# Root .gitignore for Office project

# Dependencies & Build artifacts
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Environment variables & secrets (CRITICAL FOR DEPLOYMENT SAFETY)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow env template
!.env.example

# Local uploaded media/videos (keep repo clean)
public/videos/*
!public/videos/.gitkeep
learning_app/public/videos/*
!learning_app/public/videos/.gitkeep

# System & Editor
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
