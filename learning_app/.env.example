# ==============================================================================
# LEARNING APP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in production hosting.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server LAN Network Binding (0.0.0.0 listens to all LAN devices)
HOST=0.0.0.0
PORT=3000

# Central Server PC Storage Directory (defaults to <project-root>/uploads if empty)
# Example: UPLOAD_DIR=C:\Company-LMS\uploads
UPLOAD_DIR=

# Application Base URL (for certificate links and client redirects; optional on LAN as browser relative URLs work universally)
# NEXT_PUBLIC_APP_URL=http://192.168.1.50:3000

# Local or Production MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=learning_app_db

# Local Auth JWT Secret (Generate a strong 32+ char random key in production)
JWT_SECRET=change_this_to_a_secure_random_string_for_production

# Optional: Admin Bypass (Set ONLY for local troubleshooting, NEVER in production)
ALLOW_ADMIN_BYPASS=false
