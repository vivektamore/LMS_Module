# ==============================================================================
# LEARNING APP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in production hosting.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Application Base URL (for certificate links and callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local or Production MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=learning_app_db

# Local Auth JWT Secret (Generate a strong 32+ char random key in production)
JWT_SECRET=change_this_to_a_secure_random_string_for_production

# Optional: Admin Bypass (Set ONLY for local troubleshooting, NEVER in production)
ALLOW_ADMIN_BYPASS=false
