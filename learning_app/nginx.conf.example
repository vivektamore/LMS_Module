# ==============================================================================
# Nginx Reverse Proxy Configuration for Jolly Clamps Technical LMS
# Optimized for 1,000+ Shop-Floor Employees (Intranet Video Streaming & APIs)
# ==============================================================================

upstream nextjs_upstream {
    # PM2 Next.js Cluster running on localhost port 3000
    server 127.0.0.1:3000 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

server {
    listen 80;
    server_name lms.jollyclamps.local 192.168.1.100; # Replace with Company Server IP / Hostname

    # Client body upload cap for course MP4 video uploads (matches 500MB setting)
    client_max_body_size 500M;
    client_body_timeout 300s;

    # Performance Tuning for High Concurrency
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # Gzip Compression for Next.js assets and API payloads
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml;

    # --------------------------------------------------------------------------
    # 1. Zero-Copy Native Video Streaming Direct Offloading
    #    Nginx directly handles MP4/WebM video range requests bypassing Node.js
    # --------------------------------------------------------------------------
    location /videos/ {
        alias /path/to/learning_app/public/videos/; # Replace with absolute path to public/videos/
        expires 30d;
        add_header Cache-Control "public, no-transform";
        
        # Byte-range requests support for seamless video seeking in player
        mp4;
        mp4_buffer_size      1m;
        mp4_max_buffer_size  50m;
    }

    # --------------------------------------------------------------------------
    # 2. Next.js Static Asset Caching (JS/CSS/Chunks/Images)
    # --------------------------------------------------------------------------
    location /_next/static/ {
        proxy_pass http://nextjs_upstream;
        proxy_set_header Host $host;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /public/ {
        alias /path/to/learning_app/public/;
        expires 30d;
        access_log off;
    }

    # --------------------------------------------------------------------------
    # 3. Dynamic App & API Reverse Proxy to PM2 Cluster
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;

        # Upgrade headers for WebSockets / SSE if needed
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';

        # Real Client IP Pass-Through
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Proxy Timeouts for Video Uploads & Long Queries
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Buffer Configuration
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
